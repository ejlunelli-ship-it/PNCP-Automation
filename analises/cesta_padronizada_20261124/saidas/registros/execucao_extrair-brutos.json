  "consultas": {
    "universo_compras": "SELECT fonte, modalidade_nome, situacao_compra, COUNT(*), MIN(data_publicacao), MAX(data_publicacao) FROM compras GROUP BY 1, 2, 3 ORDER BY 1, 2, 3",
    "universo_itens": "SELECT co.fonte, co.modalidade_nome, i.material_ou_servico, i.cod_item_catalogo IS NOT NULL, COUNT(*), COUNT(DISTINCT i.numero_controle_pncp || '#' || i.numero_item) FROM itens i JOIN compras co ON co.numero_controle_pncp = i.numero_controle_pncp GROUP BY 1, 2, 3, 4 ORDER BY 1, 2, 3, 4",
    "itens_orfaos": "SELECT COUNT(*) FROM itens i WHERE NOT EXISTS (SELECT 1 FROM compras c WHERE c.numero_controle_pncp = i.numero_controle_pncp)",
    "compras_base": "SELECT numero_controle_pncp, id_compra, uasg, orgao_cnpj, orgao_nome, numero_compra, ano_compra, modalidade_nome, data_publicacao, data_abertura_proposta, uf, esfera, poder FROM compras WHERE fonte = ? ORDER BY numero_controle_pncp",
    "itens_linhas": "SELECT i.id, i.numero_controle_pncp, i.numero_item, i.id_compra_item, i.registro_principal, i.uasg_item, i.cod_item_catalogo, i.material_ou_servico, i.codigo_classe, i.codigo_grupo, i.codigo_pdm, i.unidade_medida, i.descricao_resumida, i.quantidade, i.situacao_item, i.homologado, i.criterio_julgamento, i.data_atualizacao FROM compras co JOIN itens i ON i.numero_controle_pncp = co.numero_controle_pncp WHERE co.fonte = ? ORDER BY i.id"
